{
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/board.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
